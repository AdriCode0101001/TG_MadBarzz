APP_NAME="MadBarzz"
# El default de este archivo (molde para producción) es el SEGURO:
# APP_ENV=local y APP_DEBUG=false. Si copiás esto tal cual a producción
# (Oracle Cloud) y te olvidás de tocar nada, no se filtran stack traces.
#
# En producción real:      APP_ENV=production, APP_DEBUG=false (siempre)
# En tu desarrollo local:  cambiá vos a mano APP_DEBUG=true en TU .env
#   (nunca en este .env.example) para ver los errores completos.
# APP_DEBUG=true en producción expone rutas del servidor, queries SQL y
# variables de entorno a cualquier visitante ante un error no controlado.
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=https://tudominio.com
APP_TIMEZONE=America/La_Paz

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# En producción usar: LOG_LEVEL=error
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=Calistenia_M
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@tudominio.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── AWS S3 (si se usa directamente, no para backups) ─────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_ENDPOINT=

# ── Backblaze B2 — destino externo de respaldos ───────────────────────────────
# Cómo obtener estos valores: ver RESTAURACION.md § "Configurar Backblaze B2"
# Deja vacío B2_BUCKET en desarrollo; el backup externo solo se activa en VPS.
#
# B2_KEY_ID        → "keyID" de la Application Key (no el Account ID)
# B2_APPLICATION_KEY → "applicationKey" (solo visible al crearlo, guárdalo)
# B2_REGION        → región del bucket, ej: us-west-004  (del endpoint del bucket)
# B2_BUCKET        → nombre del bucket creado en B2, ej: madbarzz-backups
# B2_ENDPOINT      → https://s3.<region>.backblazeb2.com  ej: https://s3.us-west-004.backblazeb2.com
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_REGION=
B2_BUCKET=
B2_ENDPOINT=

# ── Configuración de respaldos (Fase 4) ───────────────────────────────────────
# Email del administrador que recibe alertas cuando un backup falla
BACKUP_MAIL_TO=admin@tudominio.com
# Contraseña para encriptar el ZIP del backup (deja vacío para sin cifrado)
BACKUP_ARCHIVE_PASSWORD=

# Ruta al binario mysqldump (solo necesario en Windows/XAMPP).
# En Linux/VPS dejar vacío (mysqldump ya está en PATH).
# Ejemplo Windows: MYSQLDUMP_PATH=C:/xampp/mysql/bin/
MYSQLDUMP_PATH=

VITE_APP_NAME="${APP_NAME}"

# ── Notificaciones automáticas (Fase 5) ───────────────────────────────────────
# Días de anticipación para avisar antes del vencimiento de membresía
NOTIF_DIAS_AVISO=3
# Canales activos separados por coma: email, telegram, whatsapp, push
# Ejemplos: NOTIF_CANALES=email  |  NOTIF_CANALES=email,telegram,push
NOTIF_CANALES=email

# Telegram Bot API (gratis) — crea tu bot con @BotFather en Telegram
# El cliente debe enviar /start al bot para obtener su chat_id (se guarda en personas.telegram_chat_id)
TELEGRAM_BOT_TOKEN=

# WhatsApp Cloud API — Meta (capa gratuita)
# Obtén Phone Number ID y Token en developers.facebook.com → WhatsApp → API Setup
WHATSAPP_CLOUD_PHONE_ID=
WHATSAPP_CLOUD_TOKEN=

# VAPID — claves del servidor para Web Push (notificaciones al celular sin
# app). Se generan con \Minishlink\WebPush\VAPID::createVapidKeys() (la
# librería minishlink/web-push ya viene instalada; no hace falta ningún
# paquete ni comando artisan extra). NUNCA commitear los valores reales.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@madbarzz.com

# Twilio — para notificaciones WhatsApp
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
